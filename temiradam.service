[Unit]
Description=Темірадам Local Voice Assistant
Documentation=https://github.com/
After=pipewire.service wireplumber.service dbus.service network.target
Wants=pipewire.service wireplumber.service dbus.service
ConditionUser=!root

[Service]
Type=simple
# Load user profile for Wayland/D-Bus environments
Environment="XDG_SESSION_TYPE=wayland"
Environment="DISPLAY=:0"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin"

# Run from the project directory
WorkingDirectory=%h/TemirAdam

# Start the python application
ExecStart=/usr/bin/python3 main.py run

# Restart policy: automatically restart on failure
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Output to systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
